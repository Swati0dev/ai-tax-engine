generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TaxKnowledgeItem {
  id                   String            @id @default(cuid())
  category             TaxCategory
  actName              String
  sectionNumber        String?
  title                String
  summary              String
  explanation          String
  applicability        String[]
  benefitsOrDeductions String[]
  restrictions         String[]
  examples             String[]
  relatedForms         String[]
  filingProcedure      String[]
  relatedItems         String[]
  relatedCalculators   String[]
  tags                 String[]
  financialYear        String?
  assessmentYear       String?
  faqs                 FAQ[]
  effectiveFrom        DateTime?
  lastReviewed         DateTime          @default(now())
  reviewStatus         ReviewStatus      @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  slug                 String            @unique
  imageUrl             String?
  sourceReferences     SourceReference[]

  @@index([category])
  @@index([reviewStatus])
  @@index([category, reviewStatus])
}

model SourceReference {
  id              String           @id @default(cuid())
  title           String
  url             String
  sourceType      SourceType       @default(OFFICIAL)
  publishedAt     DateTime?
  accessedAt      DateTime         @default(now())
  knowledgeItemId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  knowledgeItem   TaxKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model FAQ {
  id              String           @id @default(cuid())
  question        String
  answer          String           @db.Text
  knowledgeItemId String
  knowledgeItem   TaxKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([knowledgeItemId])
}

enum TaxCategory {
  DIRECT_TAX
  INDIRECT_TAX
  INCOME_TAX
  GST
  TDS
  CORPORATE_TAX
  CAPITAL_GAINS
  STARTUP_COMPLIANCE
  INTERNATIONAL_TAX
  BUSINESS_TAX
}

enum ReviewStatus {
  VERIFIED
  NEEDS_REVIEW
  OUTDATED
  DRAFT
}

enum SourceType {
  OFFICIAL
  PROJECT_APPROVED
  ORIENTATION_ONLY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]

  // Custom platform fields
  progress         UserProgress?
  profile          UserProfile?
  calculations     SavedCalculation[]
  chats            ChatConversation[]
  complianceEvents ComplianceEvent[]
  notifications    Notification[]
  savedContents    SavedContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  xp            Int      @default(0)
  level         Int      @default(1)
  title         String   @default("Tax Novice")
  completedDocs String[]
  checkInDates  String[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TaxRegime {
  OLD
  NEW
  EQUAL
}

model SavedCalculation {
  id            String @id @default(cuid())
  userId        String
  financialYear String @default("2024-25")
  engineVersion String @default("1.0.0")

  // Stored inputs (flattened for now, but keeping data Json for future complex categories)
  grossSalary        Float
  hraExemption       Float
  section80C         Float
  section80D         Float
  otherDeductions    Float
  interestOnHomeLoan Float

  // A generic data field for future extensibility without breaking schema
  additionalDeductions Json?

  // Calculated Results
  recommendedRegime TaxRegime
  taxUnderOld       Float
  taxUnderNew       Float
  taxSavings        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String           @db.Text
  sources        Json?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  CA
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  occupation            String? // Salaried, Freelancer, Business Owner, Student, Retired, Investor, Creator
  businessStatus        String? // No business, planning to start, already registered, unregistered
  ageBracket            String? // Below 60, 60-80, Above 80
  annualIncomeEstimate  String?
  filingExperience      String? // First-time, Experienced
  state                 String?
  taxGoals              String[] // File ITR, Save Tax, Start Business, GST, Learn
  guidanceLevel         String? // Beginner, Detailed
  existingRegistrations String[] // PAN, GST, MSME, LLP, Pvt Ltd
  preferredLanguage     String? // English, Hindi, Hinglish

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ComplianceEventType {
  ITR_FILING
  GST_FILING
  ADVANCE_TAX
  TDS_PAYMENT
  ROC
  AUDIT
  NOTICE
  OTHER
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum CompliancePriority {
  HIGH
  MEDIUM
  LOW
}

enum EventSource {
  SYSTEM
  USER
}

model ComplianceEvent {
  id                String              @id @default(cuid())
  userId            String
  title             String
  description       String?
  eventType         ComplianceEventType
  dueDate           DateTime
  status            ComplianceStatus    @default(PENDING)
  priority          CompliancePriority  @default(MEDIUM)
  source            EventSource         @default(SYSTEM)
  isSystemGenerated Boolean             @default(true)
  reminderAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
}

enum NotificationType {
  SYSTEM
  ACTIVITY
  CALCULATION
  COMPLIANCE
  KNOWLEDGE
  AI
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id     String @id @default(cuid())
  userId String

  type     NotificationType
  severity NotificationSeverity

  title   String
  message String

  isRead Boolean @default(false)

  actionUrl String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

enum SavedContentType {
  KNOWLEDGE_ARTICLE
  AI_CONVERSATION
  CALCULATION
  CHECKLIST
  TEMPLATE
}

model SavedContent {
  id     String @id @default(cuid())
  userId String

  type        SavedContentType
  title       String
  description String?
  referenceId String? // e.g., knowledge item ID, or calculation ID

  tags     String[]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// ==========================================
// REGULATORY INTELLIGENCE ENGINE (RIE)
// ==========================================

enum SourceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CRON
}

enum SourceHealthStatus {
  HEALTHY
  DEGRADED
  FAILING
  UNKNOWN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AuditAction {
  SOURCE_REGISTERED
  SOURCE_ENABLED
  SOURCE_DISABLED
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
}

model OfficialSource {
  id                String             @id @default(cuid())
  name              String
  authority         String
  url               String
  type              String             @default("WEBSITE")
  enabled           Boolean            @default(true)
  frequency         SourceFrequency    @default(DAILY)
  priority          Int                @default(1)
  parserName        String?
  healthStatus      SourceHealthStatus @default(UNKNOWN)
  lastChecked       DateTime?
  lastSuccessfulRun DateTime?

  snapshots     SourceSnapshot[]
  jobs          SchedulerJob[]
  healthMetrics SourceHealth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SourceSnapshot {
  id       String         @id @default(cuid())
  sourceId String
  source   OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  contentHash String
  metadata    Json?

  capturedAt DateTime @default(now())

  @@index([sourceId])
}

model SchedulerJob {
  id       String         @id @default(cuid())
  sourceId String
  source   OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  status       JobStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([status])
}

model SourceHealth {
  id       String         @id @default(cuid())
  sourceId String
  source   OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  status       SourceHealthStatus
  latencyMs    Int?
  errorMessage String?            @db.Text

  recordedAt DateTime @default(now())

  @@index([sourceId])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityId   String?
  entityType String?
  details    Json?

  createdAt DateTime @default(now())

  @@index([action])
}
