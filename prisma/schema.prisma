generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TaxKnowledgeItem {
  id                   String            @id @default(cuid())
  category             TaxCategory
  actName              String
  sectionNumber        String?
  title                String
  summary              String
  explanation          String
  applicability        String[]
  benefitsOrDeductions String[]
  restrictions         String[]
  examples             String[]
  relatedForms         String[]
  filingProcedure      String[]
  relatedItems         String[]
  effectiveFrom        DateTime?
  lastReviewed         DateTime          @default(now())
  reviewStatus         ReviewStatus      @default(DRAFT)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  slug                 String            @unique
  imageUrl             String?
  assessmentYear       String?
  financialYear        String?
  relatedCalculators   String[]
  tags                 String[]
  faqs                 FAQ[]
  sourceReferences     SourceReference[]

  @@index([category])
  @@index([reviewStatus])
  @@index([category, reviewStatus])
}

model SourceReference {
  id              String           @id @default(cuid())
  title           String
  url             String
  sourceType      SourceType       @default(OFFICIAL)
  publishedAt     DateTime?
  accessedAt      DateTime         @default(now())
  knowledgeItemId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  knowledgeItem   TaxKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model FAQ {
  id              String           @id @default(cuid())
  question        String
  answer          String
  knowledgeItemId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  knowledgeItem   TaxKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId])
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String?            @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             UserRole           @default(USER)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  accounts         Account[]
  chats            ChatConversation[]
  complianceEvents ComplianceEvent[]
  notifications    Notification[]
  calculations     SavedCalculation[]
  savedContents    SavedContent[]
  sessions         Session[]
  profile          UserProfile?
  progress         UserProgress?
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  xp            Int      @default(0)
  level         Int      @default(1)
  title         String   @default("Tax Novice")
  completedDocs String[]
  checkInDates  String[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedCalculation {
  id                   String    @id @default(cuid())
  userId               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  additionalDeductions Json?
  engineVersion        String    @default("1.0.0")
  financialYear        String    @default("2024-25")
  grossSalary          Float
  hraExemption         Float
  interestOnHomeLoan   Float
  otherDeductions      Float
  recommendedRegime    TaxRegime
  section80C           Float
  section80D           Float
  taxSavings           Float
  taxUnderNew          Float
  taxUnderOld          Float
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String
  sources        Json?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  occupation            String?
  businessStatus        String?
  ageBracket            String?
  annualIncomeEstimate  String?
  filingExperience      String?
  state                 String?
  taxGoals              String[]
  guidanceLevel         String?
  existingRegistrations String[]
  preferredLanguage     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ComplianceEvent {
  id                String              @id @default(cuid())
  userId            String
  title             String
  description       String?
  eventType         ComplianceEventType
  dueDate           DateTime
  status            ComplianceStatus    @default(PENDING)
  priority          CompliancePriority  @default(MEDIUM)
  source            EventSource         @default(SYSTEM)
  isSystemGenerated Boolean             @default(true)
  reminderAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueDate])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  severity  NotificationSeverity
  title     String
  message   String
  isRead    Boolean              @default(false)
  actionUrl String?
  metadata  Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model SavedContent {
  id          String           @id @default(cuid())
  userId      String
  type        SavedContentType
  title       String
  description String?
  referenceId String?
  tags        String[]
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model OfficialSource {
  id                 String              @id @default(cuid())
  name               String
  authority          String
  url                String
  type               String              @default("WEBSITE")
  enabled            Boolean             @default(true)
  frequency          SourceFrequency     @default(DAILY)
  priority           Int                 @default(1)
  parserName         String?
  healthStatus       SourceHealthStatus  @default(UNKNOWN)
  lastChecked        DateTime?
  lastSuccessfulRun  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accessStrategy     AccessStrategy      @default(HTTP_FETCH)
  canonicalDocuments CanonicalDocument[]
  changeSets         ChangeSet[]
  jobs               SchedulerJob[]
  healthMetrics      SourceHealth[]
  snapshots          SourceSnapshot[]
}

model SourceSnapshot {
  id                String             @id @default(cuid())
  sourceId          String
  contentHash       String
  metadata          Json?
  capturedAt        DateTime           @default(now())
  canonicalDocument CanonicalDocument?
  source            OfficialSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model SchedulerJob {
  id           String         @id @default(cuid())
  sourceId     String
  status       JobStatus      @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  source       OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
}

model SourceHealth {
  id           String             @id @default(cuid())
  sourceId     String
  status       SourceHealthStatus
  latencyMs    Int?
  errorMessage String?
  recordedAt   DateTime           @default(now())
  source       OfficialSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityId   String?
  entityType String?
  details    Json?
  createdAt  DateTime    @default(now())

  @@index([action])
}

model CanonicalDocument {
  id            String         @id @default(cuid())
  sourceId      String
  snapshotId    String         @unique
  title         String
  authority     String?
  content       String
  url           String
  publishedAt   DateTime?
  effectiveFrom DateTime?
  metadata      Json?
  contentHash   String
  createdAt     DateTime       @default(now())
  snapshot      SourceSnapshot @relation(fields: [snapshotId], references: [id])
  source        OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model ChangeSet {
  id              String             @id @default(cuid())
  sourceId        String
  oldDocumentId   String?
  newDocumentId   String
  severity        ChangeSeverity     @default(LOW)
  changes         Json
  isProcessedByAI Boolean            @default(false)
  createdAt       DateTime           @default(now())
  source          OfficialSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  analysis        ChangeSetAnalysis?

  @@index([sourceId])
  @@index([isProcessedByAI])
}

model ChangeSetAnalysis {
  id              String         @id @default(cuid())
  changeSetId     String         @unique
  summary         String
  impact          String
  recommendations String
  provider        String
  model           String
  status          AnalysisStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  changeSet       ChangeSet      @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@index([changeSetId])
  @@index([status])
}

enum TaxCategory {
  DIRECT_TAX
  INDIRECT_TAX
  INCOME_TAX
  GST
  TDS
  CORPORATE_TAX
  CAPITAL_GAINS
  STARTUP_COMPLIANCE
  INTERNATIONAL_TAX
  BUSINESS_TAX
  GENERAL
}

enum ReviewStatus {
  VERIFIED
  NEEDS_REVIEW
  OUTDATED
  DRAFT
}

enum SourceType {
  OFFICIAL
  PROJECT_APPROVED
  ORIENTATION_ONLY
}

enum TaxRegime {
  OLD
  NEW
  EQUAL
}

enum UserRole {
  USER
  ADMIN
  CA
  SUPER_ADMIN
}

enum ComplianceEventType {
  ITR_FILING
  GST_FILING
  ADVANCE_TAX
  TDS_PAYMENT
  ROC
  AUDIT
  NOTICE
  OTHER
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum CompliancePriority {
  HIGH
  MEDIUM
  LOW
}

enum EventSource {
  SYSTEM
  USER
}

enum NotificationType {
  SYSTEM
  ACTIVITY
  CALCULATION
  COMPLIANCE
  KNOWLEDGE
  AI
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum SavedContentType {
  KNOWLEDGE_ARTICLE
  AI_CONVERSATION
  CALCULATION
  CHECKLIST
  TEMPLATE
}

enum SourceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CRON
}

enum SourceHealthStatus {
  HEALTHY
  DEGRADED
  FAILING
  UNKNOWN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AuditAction {
  SOURCE_REGISTERED
  SOURCE_ENABLED
  SOURCE_DISABLED
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
  FETCH_STARTED
  FETCH_COMPLETED
  FETCH_FAILED
  SNAPSHOT_CREATED
}

enum AccessStrategy {
  HTTP_FETCH
  RSS_FEED
  XML_FEED
  JSON_API
  FILE_DOWNLOAD
  HEADLESS_BROWSER
}

enum ChangeSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
